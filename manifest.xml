<?xml version="1.0" encoding="utf-8"?>
<!--
  Anakin for Excel — add-in-only (XML) manifest.

  This is the production manifest format for Excel add-ins. The newer unified
  JSON manifest for Microsoft 365 is documented as "in preview for Excel,
  PowerPoint, and Word add-ins. It should not be used for production
  add-ins" (learn.microsoft.com/office/dev/add-ins/develop/yeoman-generator-overview,
  "Word, PowerPoint, or Excel with unified manifest option" section, read
  live — see SUBMIT.md). The unified manifest is production-ready for
  Outlook, not yet for Excel. So this submission uses the XML format, which
  every current Excel add-in — including Microsoft's own reference samples —
  still ships.

  Structure (Hosts/Requirements/VersionOverrides/ExtensionPoint shape, the
  SharedRuntime requirement set, the CustomFunctions ExtensionPoint fields)
  copied from the real, current OfficeDev/Office-Add-in-samples reference
  add-in at Samples/excel-shared-runtime-scenario/manifest.xml, pulled live
  via raw.githubusercontent.com, not guessed.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <!-- Basic Settings: used by clients that don't understand VersionOverrides. -->
  <Id>05ce2872-9325-4b17-8d06-0113711900ea</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Anakin</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Anakin" />
  <Description DefaultValue="Scrape, map, and crawl sites, run AI search/research, discover and run Wire automation, compare AI-visibility answers, and inspect monitors/sessions — via cell formulas (=ANAKIN.SCRAPE, =ANAKIN.MAP, and more) or the task pane." />
  <IconUrl DefaultValue="https://excel-addin.anakin.io/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://excel-addin.anakin.io/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://anakin.io/dashboard" />

  <AppDomains>
    <AppDomain>https://anakin.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <!-- SharedRuntime lets the task pane and the custom functions runtime
           share one JS context/state (e.g. window.localStorage) instead of
           each getting an isolated one. Needed here because the API key is
           entered once in the task pane and must be readable by the
           ANAKIN.* custom functions — see functions.js and README.md. -->
      <Set Name="SharedRuntime" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://excel-addin.anakin.io/src/taskpane/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <Runtimes>
          <Runtime resid="Taskpane.Url" lifetime="long" />
        </Runtimes>

        <AllFormFactors>
          <!-- Custom Functions surface: =ANAKIN.SCRAPE(...), =ANAKIN.SEARCH(...),
               =ANAKIN.AGENTICSEARCH(...) callable from any cell.

               Script and Page both point at Taskpane.Url (taskpane.html), not
               a separate functions.html. Confirmed against the real reference
               sample (Office-Add-in-samples/Samples/excel-shared-runtime-scenario
               /manifest.xml): under a shared runtime, custom functions and the
               task pane run in one JS context/page — taskpane.html loads
               functions.js via a <script> tag alongside taskpane.js, and both
               see the same globals (see src/taskpane/taskpane.html and
               src/utilities/state.js). Metadata still points at its own
               functions.json — that file has no page to render, Excel just
               reads it as data. -->
          <ExtensionPoint xsi:type="CustomFunctions">
            <Script>
              <SourceLocation resid="Taskpane.Url" />
            </Script>
            <Page>
              <SourceLocation resid="Taskpane.Url" />
            </Page>
            <Metadata>
              <SourceLocation resid="Functions.Metadata.Url" />
            </Metadata>
            <Namespace resid="Functions.Namespace" />
          </ExtensionPoint>
        </AllFormFactors>

        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>

          <!-- No <FunctionFile> element: it backs ExecuteFunction ribbon
               commands and custom keyboard shortcuts (confirmed at
               learn.microsoft.com/javascript/api/manifest/functionfile), and
               this add-in's only ribbon control is ShowTaskpane, not
               ExecuteFunction. -->

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <!-- "TabHome" confirmed as Excel's built-in Home tab ID at
                 learn.microsoft.com/office/dev/add-ins/develop/built-in-ui-ids
                 (the per-app ID list there is TabHome, TabInsert,
                 TabPageLayoutExcel, TabFormulas, TabData, TabReview, TabView,
                 TabDeveloper, TabAddIns for Excel — TabHome itself is shared
                 with Word/PowerPoint/OneNote; only Page Layout needed an
                 Excel-specific suffix, to disambiguate from Word's). -->
            <OfficeTab id="TabHome">
              <Group id="AnakinGroup">
                <Label resid="AnakinGroup.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="BtnShowTaskpane">
                  <Label resid="BtnShowTaskpane.Label" />
                  <Supertip>
                    <Title resid="BtnShowTaskpane.Label" />
                    <Description resid="BtnShowTaskpane.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Anakin.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://excel-addin.anakin.io/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://excel-addin.anakin.io/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://excel-addin.anakin.io/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://excel-addin.anakin.io/src/taskpane/taskpane.html" />
        <bt:Url id="Functions.Metadata.Url" DefaultValue="https://excel-addin.anakin.io/src/functions/functions.json" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://anakin.io/dashboard" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Functions.Namespace" DefaultValue="ANAKIN" />
        <bt:String id="GetStarted.Title" DefaultValue="Get started with Anakin" />
        <bt:String id="AnakinGroup.Label" DefaultValue="Anakin" />
        <bt:String id="BtnShowTaskpane.Label" DefaultValue="Anakin" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Enter your Anakin API key, then scrape/map/crawl sites, search, or run Wire automation and AI-visibility checks — via ANAKIN.* formulas in a cell, or the task pane for sign-in, monitors, and other actions that change state." />
        <bt:String id="BtnShowTaskpane.Tooltip" DefaultValue="Open the Anakin task pane to scrape/map/crawl sites, search the web, run agentic research, and manage Wire sign-ins, monitors, and browser sessions." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
